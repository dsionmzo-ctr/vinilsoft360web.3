<?xml version="1.0" encoding="UTF-8"?>

<!--
=========================================================
Proyecto : Vinilsoft360
Descripción:
Archivo de configuración Maven encargado de administrar
las dependencias, plugins y configuración de compilación
del proyecto web.

Autor: Dayson Mazo Villa
SENA - Análisis y Desarrollo de Software
=========================================================
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ============================================== -->
    <!-- Información general del proyecto               -->
    <!-- ============================================== -->

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vinilsoft360</groupId>

    <artifactId>vinilsoft360web</artifactId>

    <version>1.0-SNAPSHOT</version>

    <packaging>war</packaging>

    <!-- ============================================== -->
    <!-- Configuración de Java                          -->
    <!-- ============================================== -->

    <properties>

        <maven.compiler.release>17</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>

    
    <!-- Dependencias utilizadas por el proyecto        -->
    

    <dependencies>

        <!-- API Jakarta Servlet -->

        <dependency>

            <groupId>jakarta.servlet</groupId>

            <artifactId>jakarta.servlet-api</artifactId>

            <version>6.0.0</version>

            <scope>provided</scope>

        </dependency>

        <!-- API Jakarta JSP -->

        <dependency>

            <groupId>jakarta.servlet.jsp</groupId>

            <artifactId>jakarta.servlet.jsp-api</artifactId>

            <version>3.1.1</version>

            <scope>provided</scope>

        </dependency>

        <!-- Driver de conexión MySQL -->

        <dependency>

            <groupId>com.mysql</groupId>

            <artifactId>mysql-connector-j</artifactId>

            <version>9.4.0</version>

        </dependency>

        <!-- Librería para convertir objetos Java a JSON -->

        <dependency>

            <groupId>com.google.code.gson</groupId>

            <artifactId>gson</artifactId>

            <version>2.13.1</version>

        </dependency>

    </dependencies>

    
    <!-- Configuración de compilación Maven             -->
  

    <build>

        <finalName>vinilsoft360web</finalName>

        <plugins>

            <!-- Plugin compilador Java -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-compiler-plugin</artifactId>

                <version>3.15.0</version>

                <configuration>

                    <release>17</release>

                </configuration>

            </plugin>

            <!-- Plugin para generar archivos WAR -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-war-plugin</artifactId>

                <version>3.5.0</version>

            </plugin>

        </plugins>

    </build>

</project>